node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# npm 锁文件（覆盖全局 ~/.gitignore_global 中的忽略规则）
!package-lock.json

# 本地 AI 工具与工作流数据，不进版本控制
.claude/
.cursor/
.workbuddy/
.superagent-events.jsonl
.superagent-commands.jsonl
.superagent-loop.jsonl
.superagent-audit.jsonl
.superagent-state.json.corrupt-*

# Trellis：共享规范、工作流、配置与运行时脚本；本地运行数据仍排除
.trellis/*
!.trellis/spec/
!.trellis/workflow.md
!.trellis/config.yaml
!.trellis/scripts/
!.trellis/agents/
!.trellis/.gitignore

# 运行态 state 快照（演示数据），不进版本控制
.superagent-state.json

# Agent 隔离工作树（git worktree 真实落盘目录）
.worktrees/
