CREATE TABLE task_nodes (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  req_id UUID REFERENCES requirements(id) ON DELETE CASCADE,
  title TEXT NOT NULL,
  role TEXT NOT NULL,
  provider TEXT NOT NULL,
  depends_on UUID[] DEFAULT '{}',
  state TEXT NOT NULL DEFAULT 'PENDING',
  retry_count INT NOT NULL DEFAULT 0,
  max_retries INT NOT NULL DEFAULT 3,
  assigned_machine TEXT,
  worktree_branch TEXT,
  diff_patch TEXT,
  updated_at TIMESTAMPTZ DEFAULT now()
);


CREATE TABLE task_checkpoints (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  task_id UUID REFERENCES task_nodes(id) ON DELETE CASCADE,
  gate_type TEXT NOT NULL,
  summary_md TEXT NOT NULL,
  status TEXT NOT NULL DEFAULT 'WAITING',
  reviewer_id UUID,
  comment TEXT,
  created_at TIMESTAMPTZ DEFAULT now(),
  resolved_at TIMESTAMPTZ
);


CREATE TABLE memory_assets (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  team_id UUID NOT NULL,
  project_id UUID,
  owner_id UUID NOT NULL,
  asset_type TEXT NOT NULL,
  scope TEXT NOT NULL DEFAULT 'team',
  status TEXT NOT NULL DEFAULT 'draft',
  title TEXT NOT NULL,
  content_md TEXT NOT NULL,
  metadata JSONB DEFAULT '{}',
  embedding vector(1536),
  version INT NOT NULL DEFAULT 1,
  created_at TIMESTAMPTZ DEFAULT now()
);


CREATE TABLE asset_acl (
  asset_id UUID REFERENCES memory_assets(id) ON DELETE CASCADE,
  subject_type TEXT NOT NULL,
  subject_id TEXT NOT NULL,
  permission TEXT NOT NULL DEFAULT 'read',
  PRIMARY KEY (asset_id, subject_type, subject_id)
);


CREATE INDEX idx_memory_vec ON memory_assets USING hnsw (embedding vector_cosine_ops);
8. Daemon 安全护栏与 Day-1 执行步骤
* 断线续传：Daemon 本地 SQLite 缓存带递增 seq 的事件队列，重连后按 lastAckSeq 补发。
* 沙箱护栏：路径白名单强制限定在 ~/.superagent/worktrees/<taskId>；高危命令（rm -rf /、DROP TABLE、git push --force）触发 DANGER_GATE；出站 L0 日志经过密钥/PII 正则脱敏后再上传云端。
* Day-1 启动顺序：
   1. 初始化 pnpm + turbo.json 并用 Docker Compose 拉起 PostgreSQL 16 (pgvector) 与 Redis 7，执行上述 DDL。
   2. 实现 packages/protocol 与 apps/daemon 的 worktree 管理及 codex exec --json 适配器。
   3. 启动 apps/server WebSocket 网关与状态机，验证单节点 RUNNING → VERIFYING → HUMAN_GATE → MERGED 闭环。
   4. 接入 apps/web 三栏控制台验证并行 Worktree Diff 切换与打回重做。
   5. 挂载 .teamai/ 规范同步与 apps/memory-hub 异步提炼，验证 Skill Draft 生成与发布。