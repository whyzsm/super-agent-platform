7.1 packages/protocol/src/index.ts
export type AgentProvider = 'codex' | 'workbuddy' | 'claude-code' | 'opencode';


export type TaskState =
  | 'PENDING' | 'RUNNING' | 'VERIFYING' | 'RETRY_WAIT'
  | 'HUMAN_GATE' | 'ESCALATED' | 'MERGED' | 'CANCELLED';


export interface DagNode {
  id: string;
  reqId: string;
  title: string;
  role: 'planner' | 'builder' | 'reviewer';
  provider: AgentProvider;
  dependsOn: string[];
  state: TaskState;
  retryCount: number;
  maxRetries: number;
  worktreeBranch?: string;
}


export type DaemonCommand =
  | { type: 'SPAWN_TASK'; taskId: string; repoUrl: string; baseBranch: string; provider: AgentProvider; prompt: string; skills: string[] }
  | { type: 'INJECT_RETRY'; taskId: string; feedback: string }
  | { type: 'GATE_DECISION'; taskId: string; toolCallId?: string; approved: boolean; comment?: string }
  | { type: 'ABORT_TASK'; taskId: string };


export interface DaemonEnvelope {
  machineId: string;
  seq: number;
  ts: number;
  payload:
    | { type: 'HEARTBEAT'; activeTaskIds: string[]; cpuLoad: number }
    | { type: 'AGENT_EVENT'; taskId: string; event: unknown }
    | { type: 'VERIFY_RESULT'; taskId: string; passed: boolean; logs: string; diffPatch: string }
    | { type: 'STATE_ACK'; taskId: string; state: TaskState };
}
7.2 PostgreSQL + pgvector 核心 DDL
CREATE EXTENSION IF NOT EXISTS vector;


CREATE TABLE requirements (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  team_id UUID NOT NULL,
  title TEXT NOT NULL,
  spec_md TEXT NOT NULL,
  status TEXT NOT NULL DEFAULT 'PLANNING',
  created_by UUID NOT NULL,
  created_at TIMESTAMPTZ DEFAULT now()
