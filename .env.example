# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# IM_WEBHOOK_SECRET: HMAC-SHA256 signing key for IM webhook callbacks.
# Used by GET /api/webhooks/im/card/:taskId and POST /api/webhooks/im.
# If unset, these webhook endpoints return 503 { "error": "IM_WEBHOOK_SECRET is not configured" }.
IM_WEBHOOK_SECRET="MY_IM_WEBHOOK_SECRET"

# SUPERAGENT_GATE_TIER: Q8 gate approval tier (src/policy/gateTiers.ts).
# always_confirm (default)      - every gate waits for human approval (v1 behavior)
# auto_approve_when_green       - deterministic auto-release for all-green MERGE_GATE
#                                 on non-protected branches; DANGER_GATE never auto-releases
# delegate_to_reviewer          - reserved for reviewer-model proxy; currently falls back
#                                 to human confirmation (no real reviewer model wired)
# Invalid values fail safe to always_confirm with a startup warning.
SUPERAGENT_GATE_TIER="always_confirm"

# SUPERAGENT_PG_CMD: swap the StateStore port to PostgreSQL (S1-2).
# Value is the psql invocation prefix (whitespace-split, no shell).
# Local example with the docker container from docs/decision-log.md D-13:
#   docker run -d --name superagent-pg -e POSTGRES_USER=superagent \
#     -e POSTGRES_PASSWORD=superagent-dev -e POSTGRES_DB=superagent \
#     -p 127.0.0.1:5433:5432 postgres:16-alpine
# Leave unset to keep the default atomic file-backed store.
# SUPERAGENT_PG_CMD="docker exec -i superagent-pg psql -U superagent -d superagent"
